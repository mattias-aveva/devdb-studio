@page "/instances/create"
@using DevDbStudio.Services.Dbms
@implements IDisposable
@inject IInstanceManager Manager

<PageTitle>Create instance</PageTitle>

<div class="page-header">
    <div>
        <h1>Create instance</h1>
        <p>Start a new database server container.</p>
    </div>
    <a class="btn btn-sm" href="/instances">Back to instances</a>
</div>

@if (_result is { Success: true })
{
    <div class="banner">
        <div>
            <strong>@_result.Message</strong>
            <div>@_result.Instance?.Name is listening on port @_result.Instance?.HostPort.</div>
        </div>
        <a class="btn btn-success" href="/instances">Go to instances</a>
    </div>
}
else if (_result is not null)
{
    <div class="banner banner--error">
        <div>
            <strong>@_result.Message</strong>
            @if (!string.IsNullOrWhiteSpace(_result.StdErr)) { <pre class="logs">@_result.StdErr</pre> }
        </div>
    </div>
}

<div class="card">
    <div class="card__body form form--narrow">
        <label class="field">DBMS
            <select value="@_dbms" @onchange="OnDbmsChanged" disabled="@_busy">
                @foreach (var p in Manager.Providers.OrderBy(x => x.DisplayName, StringComparer.OrdinalIgnoreCase))
                {
                    <option value="@p.Key">@p.DisplayName</option>
                }
            </select>
        </label>
        <div class="inline-info"><DbmsBadge Key="@_dbms" DisplayName="@Manager.GetProvider(_dbms)?.DisplayName" Tag="@_tag" /></div>
        <label class="field">Name
            <input type="text" @bind="_name" @bind:event="oninput" maxlength="50" disabled="@_busy" />
        </label>
        <label class="field">Host port
            <input type="number" @bind="_port" min="1024" max="65535" disabled="@_busy" />
        </label>
        <label class="field">@(Provider?.AdminUser == "sa" ? "SA password" : $"Password (user {Provider?.AdminUser})")
            <span class="inline">
                <input type="@(_showPw ? "text" : "password")" @bind="_password"                 @bind:event="oninput" @bind:after="() => _generated = false" autocomplete="new-password" disabled="@_busy" />
                <button type="button" class="btn btn-sm" @onclick="() => _showPw = !_showPw">@(_showPw ? "Hide" : "Show")</button>
                                <button type="button" class="btn btn-sm" @onclick="GeneratePassword" disabled="@_busy">Regenerate password</button>
                            </span>
                        </label>
                        @if (_generated)
                        {
                            <div class="hint hint--ok">A strong password was generated for you. Press "Show" to see it, or "Regenerate password" for a new one.</div>
                        }
                        @if (_password.Length > 0)
                        {
            var errs = InstanceValidation.PasswordErrors(_password);
            @if (errs.Count == 0) { <div class="hint hint--ok">Password meets the requirements.</div> }
            else { <ul class="hint hint--err">@foreach (var e in errs) { <li>@e</li> }</ul> }
        }
        @if (Provider?.UsesDatabaseName != false)
        {
            <label class="field">Database name
                <input type="text" @bind="_database" disabled="@_busy" />
            </label>
        }
        <label class="field">Image tag
            <input type="text" @bind="_tag" disabled="@_busy" />
        </label>
        <p class="muted">Image: <code>@Provider?.ImageName:@_tag</code>. The container is bound to 127.0.0.1 and uses a named volume for data.</p>
        <label class="check">
            <input type="checkbox" @bind="_sharedNetwork" disabled="@_busy" />
            Application container access
        </label>
        <p class="muted">Allow applications on <code>devdb-network</code> to connect using this database's container name. Loopback access stays available. <a href="/help#application-container-access">Connecting from application containers</a></p>

        @if (_errors.Count > 0)
        {
            <ul class="hint hint--err">@foreach (var e in _errors) { <li>@e</li> }</ul>
        }

        <div class="toolbar">
            <button class="btn btn-primary" @onclick="CreateAsync" disabled="@_busy">
                @if (_busy) { <span class="spinner"></span> }
                Create instance
            </button>
            @if (_busy) { <span class="muted">Creating… the first image pull can take several minutes.</span> }
            <button type="button" class="btn" @onclick="() => _showCompose = !_showCompose">@(_showCompose ? "Hide compose preview" : "Show compose preview")</button>
        </div>
    </div>
</div>

@if (_showCompose && Provider is not null)
{
    var yaml = YamlText;
    var issues = ComposePreview.Check(Provider, Request(), _existing, yaml, _lastEdit);
    <div class="card">
        <div class="card__head"><h2>Compose preview</h2></div>
        <div class="card__body">
            <p class="muted compose__note">
                This is exactly what will be created, written as a compose file. You can edit the port, image tag, password and
                database here and the form follows when you leave the editor. Other changes cannot be applied and are flagged.
                The password is hidden unless you press "Show" in the form.
            </p>
            @if (issues.Count == 0)
            {
                <ul class="issues"><li class="issue--ok">Everything looks fine.</li></ul>
            }
            else
            {
                <ul class="issues">
                    @foreach (var i in issues)
                    {
                        <li class="issue--@(i.Severity.ToString().ToLowerInvariant())"><strong>@(i.Severity == PreviewSeverity.Error ? "Error" : i.Severity == PreviewSeverity.Warning ? "Warning" : "Note"):</strong> @i.Message</li>
                    }
                </ul>
            }
            <textarea class="compose__editor" spellcheck="false" wrap="off" rows="20"
                      value="@yaml" @onchange="OnYamlChanged" disabled="@_busy"></textarea>
            <div class="toolbar">
                <button type="button" class="btn btn-sm" @onclick="ResetYaml" disabled="@(_busy || _edited is null)">Reset from form</button>
            </div>
        </div>
    </div>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private string _dbms = "", _name = "", _password = "", _database = "master", _tag = "2022-latest";
    private int _port = 1433;
    private bool _busy, _showPw, _showCompose, _generated, _sharedNetwork;
    private string? _edited, _editedKey;
    private ComposeEdit? _lastEdit;
    private IReadOnlyList<string> _errors = [];
    private InstanceCreateResult? _result;
    private IReadOnlyList<DbInstance> _existing = [];

    private IDbmsProvider? Provider => Manager.GetProvider(_dbms);

    private InstanceCreateRequest Request() => new(_name.Trim(), _dbms, _port, _password, _database.Trim(), _tag.Trim(), _sharedNetwork);

    private string FormKey => $"{_dbms}|{_port}|{_password}|{_database}|{_tag}|{_showPw}|{_sharedNetwork}";

    // The form is the source of truth: text typed in the editor only survives until the form changes.
    private string YamlText
    {
        get
        {
            if (_edited is not null && _editedKey != FormKey) { _edited = null; _lastEdit = null; }
            return _edited ?? ComposePreview.Render(Provider!, Request(), maskPassword: !_showPw);
        }
    }

    private void OnYamlChanged(ChangeEventArgs e)
    {
        if (Provider is not { } p) return;
        var text = e.Value?.ToString() ?? "";
        var edit = ComposePreview.Parse(p, Request(), text, maskPassword: !_showPw);
        if (edit.HostPort is { } port) _port = port;
        if (edit.Tag is { } tag) _tag = tag;
        if (edit.Password is { } pw) _password = pw;
        if (edit.Database is { } db) _database = db;

        _lastEdit = edit;
        _edited = edit.Ignored.Count == 0 ? null : text; // fully applied: show the normalized text again
        _editedKey = FormKey;
    }

    private void ResetYaml() { _edited = null; _lastEdit = null; }

    protected override async Task OnInitializedAsync()
    {
        _existing = await Manager.GetAllAsync(_cts.Token);
        _dbms = Manager.Providers.FirstOrDefault()?.Key ?? "";
        ApplyDefaults();
        GeneratePassword();
    }

    private void GeneratePassword()
    {
        _password = InstanceValidation.GeneratePassword();
        _generated = true;
    }

    private void OnDbmsChanged(ChangeEventArgs e)
    {
        _dbms = e.Value?.ToString() ?? _dbms;
        ApplyDefaults();
    }

    private void ApplyDefaults()
    {
        if (Provider is not { } p) return;
        var used = _existing.Select(i => i.HostPort).ToHashSet();
        var port = p.DefaultPort;
        while (used.Contains(port)) port++;
        _port = port;
        _tag = p.DefaultImageTag;
        _database = p.DefaultDatabase;
        _name = $"{p.NamePrefix}-{_existing.Count + 1}";
    }

    private async Task CreateAsync()
    {
        if (_busy) return;
        _result = null;
        var req = Request();
        _errors = InstanceValidation.Validate(req);
        if (_errors.Count > 0) return;

        _busy = true;
        try
        {
            _result = await Manager.CreateAsync(req, CancellationToken.None);
            if (_result.Success) { _password = ""; _generated = false; }
        }
        catch (Exception ex) { _result = InstanceCreateResult.Fail("Unexpected error", ex.Message); }
        finally { _busy = false; }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
