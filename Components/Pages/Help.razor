@page "/help"

<PageTitle>Help</PageTitle>

<div class="page-header">
    <div>
        <h1>Help</h1>
        <p>How to use DevDb Studio, and what to know about each supported database system.</p>
    </div>
</div>

<div class="help">
    <nav class="help__toc" aria-label="On this page">
        <div class="help__toc-title">On this page</div>
        <a href="help#overview">Overview</a>
        <a href="help#getting-started">Getting started</a>
        <a href="help#pages">The pages</a>
        <a href="help#dbms">Database systems</a>
        <a href="help#connect">Connecting from your tools</a>
        <a href="help#application-container-access">Application container access</a>
        <a href="help#data">Data, backups and deleting</a>
        <a href="help#troubleshooting">Troubleshooting</a>
